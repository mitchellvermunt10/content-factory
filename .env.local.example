# Anthropic API key — required voor de campaign generators
ANTHROPIC_API_KEY=sk-ant-...

# Optioneel: model override (default: claude-sonnet-4-6)
ANTHROPIC_MODEL=claude-sonnet-4-6

# ElevenLabs API key — voor echte voice-over synthese in de Video productie tab.
# Niet ingesteld → de /api/voice-over route valt automatisch terug op mock-mode.
# Vraag een key aan via https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# Runway API key — voor echte AI video render via /api/render/jobs/*
# Niet ingesteld → de render-agent valt automatisch terug op mock-mode
# (deterministische progress, kopieert een fixture clip naar real-assets/<slug>/clips/).
# Vraag een key aan via https://dev.runwayml.com/ → API Keys
RUNWAY_API_KEY=

# Optioneel: Runway model override (default: gen3a_turbo)
RUNWAY_MODEL=gen3a_turbo

# Optioneel: zet op "true" voor mock-mode in alle generators (geen echte API calls).
# Dit overrult ook ELEVENLABS_API_KEY en RUNWAY_API_KEY zelfs als die wel zijn ingesteld.
CONTENT_FACTORY_MOCK=false

# Supabase — voor server-side campagne-persistentie + Brand Brain.
# Zonder deze keys werkt de app op localStorage-only (campagnes blijven per-browser).
# Setup: maak een project aan op supabase.com, draai supabase/migrations/0001_campaigns.sql
# in de SQL editor, en kopieer de URL + service role key hieronder.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI API key — voor gpt-image-1 image generatie op Instagram-posts.
# LET OP: dit is ANDER dan een ChatGPT Plus abonnement. API-keys haal je op
# https://platform.openai.com/api-keys (apart account, apart credits-saldo).
# Zonder deze key valt /api/images/generate netjes terug op een 503-error.
# Cost: ~€0,04 per image (gpt-image-1 medium 1024x1024).
OPENAI_API_KEY=

# fal.ai API key — voor Flux Pro 1.1 Ultra (sterker fotorealisme dan gpt-image-1).
# Optioneel — als je 'm leeg laat is alleen OpenAI als engine beschikbaar.
# Aanmaken op https://fal.ai/dashboard/keys → ~€0,06 per image.
FAL_KEY=

# Apify token — voor Instagram-profiel scraping bij prospect-research.
# Vrijwillig: zonder dit haalt de scraper alleen foto's van de website,
# wat voor restaurants/salons vaak te weinig is. Met Apify krijg je 8-12
# extra foto's uit hun publieke Instagram-feed.
# Aanmaken op https://apify.com → Settings → Integrations → API tokens.
# Free tier $5 credit. Cost per scrape: ~$0,005 (1000 scrapes voor $5).
APIFY_TOKEN=

# Resend API key — voor cold-emails direct vanuit het platform.
# Zonder dit blijft de huidige flow (copy email naar Gmail handmatig).
# Met dit: 'Verstuur' knop in prospect-research stuurt direct.
# Aanmaken op https://resend.com → API Keys → 3K emails/mnd gratis.
# Tip: verifieer eerst nextlevelsites.nl als verzend-domein (SPF/DKIM via
# Resend dashboard, ~5 min). Anders moet je voorlopig vanaf hun
# onboarding@resend.dev verzenden (lagere deliverability).
RESEND_API_KEY=

# Default 'from' adres voor cold-emails. Zorg dat het domein is geverifieerd
# bij Resend (SPF/DKIM-records in DNS). Format: 'Naam <email@domein.nl>'.
RESEND_FROM_EMAIL=Mitchell Vermunt <mitchell@nextlevelsites.nl>
