# Anthropic API key — required voor de campaign generators
ANTHROPIC_API_KEY=sk-ant-...

# Optioneel: model override (default: claude-sonnet-4-6)
ANTHROPIC_MODEL=claude-sonnet-4-6

# ElevenLabs API key — voor echte voice-over synthese in de Video productie tab.
# Niet ingesteld → de /api/voice-over route valt automatisch terug op mock-mode.
# Vraag een key aan via https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# Runway API key — voor echte AI video render via /api/render/jobs/*
# Niet ingesteld → de render-agent valt automatisch terug op mock-mode
# (deterministische progress, kopieert een fixture clip naar real-assets/<slug>/clips/).
# Vraag een key aan via https://dev.runwayml.com/ → API Keys
RUNWAY_API_KEY=

# Optioneel: Runway model override (default: gen3a_turbo)
RUNWAY_MODEL=gen3a_turbo

# Optioneel: zet op "true" voor mock-mode in alle generators (geen echte API calls).
# Dit overrult ook ELEVENLABS_API_KEY en RUNWAY_API_KEY zelfs als die wel zijn ingesteld.
CONTENT_FACTORY_MOCK=false

# Supabase — voor server-side campagne-persistentie + Brand Brain.
# Zonder deze keys werkt de app op localStorage-only (campagnes blijven per-browser).
# Setup: maak een project aan op supabase.com, draai supabase/migrations/0001_campaigns.sql
# in de SQL editor, en kopieer de URL + service role key hieronder.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
